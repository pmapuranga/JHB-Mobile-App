# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
**/ephemeral/

# Local screenshots and emulator captures
/*.png

# Raw source audio is duplicated in assets/preload/audios and should not be
# committed twice.
/sources/Audios/

# Local copy; the packaged mobile database lives under assets/preload.
/sermon_library.sqlite

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
